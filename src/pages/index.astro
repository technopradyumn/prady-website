<script is:inline>
  function setupInteractiveElements() {
    // 1. Hero installer shell selector
    const cmdText = document.getElementById('install-cmd-text');
    const heroCopyBtn = document.getElementById('install-copy-btn');
    const installTabs = document.querySelectorAll('.install-tab-btn');
    installTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        installTabs.forEach((otherTab) => otherTab.classList.remove('active'));
        tab.classList.add('active');
        if (cmdText) cmdText.textContent = tab.getAttribute('data-cmd') || '';
      });
    });

    if (heroCopyBtn && cmdText) {
      heroCopyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(cmdText.textContent || '');
          flashCopied(heroCopyBtn);
        } catch (e) {
          console.error(e);
        }
      });
    }

    // 2. Step 1 OS Tabs (macOS/Linux vs Windows PowerShell)
    const vstepSh = document.getElementById('vstep-tab-sh');
    const vstepPs1 = document.getElementById('vstep-tab-ps1');
    const cmdSh = document.getElementById('vstep-cmd-sh');
    const cmdPs1 = document.getElementById('vstep-cmd-ps1');
    const copyStep1 = document.getElementById('vstep-copy-step1');

    if (vstepSh && vstepPs1 && cmdSh && cmdPs1) {
      vstepSh.addEventListener('click', () => {
        vstepSh.classList.add('active');
        vstepPs1.classList.remove('active');
        cmdSh.classList.add('active');
        cmdPs1.classList.remove('active');
      });

      vstepPs1.addEventListener('click', () => {
        vstepPs1.classList.add('active');
        vstepSh.classList.remove('active');
        cmdPs1.classList.add('active');
        cmdSh.classList.remove('active');
      });
    }

    if (copyStep1 && cmdSh && cmdPs1) {
      copyStep1.addEventListener('click', async () => {
        const activeCmd = cmdSh.classList.contains('active') ? cmdSh.textContent : cmdPs1.textContent;
        try {
          await navigator.clipboard.writeText(activeCmd || '');
          flashCopied(copyStep1);
        } catch (e) {
          console.error(e);
        }
      });
    }

    // 3. Universal .copy-cmd-btn with data-copy attribute or text content
    document.querySelectorAll('.copy-cmd-btn[data-copy]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (text) {
          try {
            await navigator.clipboard.writeText(text);
            flashCopied(btn);
          } catch (e) {
            console.error(e);
          }
        }
      });
    });

    function flashCopied(btn) {
      btn.classList.add('copied');
      const span = btn.querySelector('span');
      if (span) {
        const orig = span.textContent;
        span.textContent = 'Copied!';
        setTimeout(() => {
          btn.classList.remove('copied');
          span.textContent = orig;
        }, 2000);
      }
    }
  }

  setupInteractiveElements();
  document.addEventListener('astro:after-swap', setupInteractiveElements);
</script>
