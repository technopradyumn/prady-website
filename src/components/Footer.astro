---
// Footer.astro
import latestData from '../../public/latest.json';
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Pitch -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <img class="brand-logo" src="/prady-logo.svg" alt="" />
          <span class="brand-title">Prady</span>
        </div>
        <p class="brand-desc">
          A statically-typed systems and application programming language with built-in architecture-as-code verification, 28 native data structures, and zero-cost LLVM compilation.
        </p>
        <div class="footer-badges">
          <span class="badge">v{latestData.version}</span>
          <span class="badge">Open Source (MIT)</span>
        </div>
      </div>

      <!-- Col 2: Documentation -->
      <div class="footer-col">
        <h4 class="col-title">Documentation</h4>
        <ul class="col-links">
          <li><a href="/docs/getting-started/overview">Getting Started</a></li>
          <li><a href="/docs/handbook/the-basics">The Handbook</a></li>
          <li><a href="/docs/handbook/architecture-contracts">Architecture Contracts</a></li>
          <li><a href="/docs/reference/keywords-and-syntax">Keywords & Syntax</a></li>
          <li><a href="/docs/reference/data-structures">28 Data Structures</a></li>
          <li><a href="/docs/reference/standard-library">Standard Library</a></li>
        </ul>
      </div>

      <!-- Col 3: Tooling -->
      <div class="footer-col">
        <h4 class="col-title">Tooling</h4>
        <ul class="col-links">
          <li><a href="/docs/tooling/cli-reference">Prady CLI Reference</a></li>
          <li><a href="/docs/tooling/package-manager">Package Manager (<code>prady add</code>)</a></li>
          <li><a href="/docs/tooling/editor-extensions">VS Code Extension</a></li>
          <li><a href="/docs/tooling/troubleshooting">Errors & Troubleshooting</a></li>
          <li><a href="/docs/tooling/editor-extensions#lsp">Prady LSP Server</a></li>
          <li><a href="/play">In-Browser Playground</a></li>
          <li><a href="/download">Download Binaries</a></li>
        </ul>
      </div>

      <!-- Col 4: Community & Project -->
      <div class="footer-col">
        <h4 class="col-title">Community</h4>
        <ul class="col-links">
          <li><a href="https://github.com/technopradyumn/prady" target="_blank" rel="noopener noreferrer">GitHub Repository</a></li>
          <li><a href="https://github.com/technopradyumn/prady/releases" target="_blank" rel="noopener noreferrer">Releases & Changelog</a></li>
          <li><a href="https://github.com/technopradyumn/prady/issues" target="_blank" rel="noopener noreferrer">Issue Tracker</a></li>
          <li><a href="https://github.com/technopradyumn/prady-website" target="_blank" rel="noopener noreferrer">Website Source</a></li>
          <li><a href="https://github.com/technopradyumn/prady/blob/main/LICENSE" target="_blank" rel="noopener noreferrer">MIT License</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © 2026 Prady Programming Language. Designed with high-performance architectural computing in mind.
      </p>
      <div class="footer-sublinks">
        <a href="/docs">Docs</a>
        <a href="/play">Playground</a>
        <a href="/download">Download</a>
        <a href="https://github.com/technopradyumn/prady" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    margin-top: auto;
    padding-top: 4rem;
    padding-bottom: 2.5rem;
    color: var(--text-secondary);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    object-fit: contain;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .brand-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .footer-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-primary);
    margin-bottom: 1.15rem;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .col-links a {
    font-size: 0.9rem;
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .col-links a:hover {
    color: var(--accent);
  }

  .col-links code {
    font-size: 0.82em;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-sublinks {
    display: flex;
    gap: 1.5rem;
  }

  .footer-sublinks a {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-sublinks a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
    .brand-col {
      grid-column: span 1;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
