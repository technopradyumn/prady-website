---
// SearchModal.astro
---

<div id="search-modal-backdrop" class="search-backdrop hidden">
  <div class="search-modal" role="dialog" aria-modal="true" aria-label="Search documentation">
    <div class="search-input-wrapper">
      <svg class="search-icon" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="modal-search-input" 
        placeholder="Search docs, guides, keywords, or data structures..." 
        autocomplete="off" 
        spellcheck="false"
      />
      <kbd class="esc-badge" id="modal-close-btn">ESC</kbd>
    </div>

    <div class="search-results-container" id="search-results-list">
      <div class="search-empty-state">Type a keyword to search documentation...</div>
    </div>

    <div class="search-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to select</span>
      <span><kbd>ESC</kbd> to close</span>
    </div>
  </div>
</div>

<style>
  .search-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    opacity: 1;
    transition: opacity 0.15s ease;
  }

  .search-backdrop.hidden {
    display: none;
    opacity: 0;
  }

  .search-modal {
    width: 100%;
    max-width: 620px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .search-icon {
    color: var(--text-muted);
  }

  #modal-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.05rem;
    color: var(--text-primary);
    font-family: inherit;
  }

  .esc-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    cursor: pointer;
  }

  .search-results-container {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .search-empty-state {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.12s ease;
    cursor: pointer;
    margin-bottom: 0.25rem;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.selected) {
    background-color: var(--accent-subtle);
  }

  :global(.search-result-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  :global(.search-result-title) {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  :global(.search-result-category) {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    background-color: var(--badge-bg);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  :global(.search-result-snippet) {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    line-height: 1.4;
  }

  .search-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.25rem;
    padding: 0.65rem 1.25rem;
    border-top: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .search-footer kbd {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    font-weight: 600;
  }
</style>

<script is:inline>
  const searchIndex = [
    { title: "Getting Started with Prady", category: "Guides", url: "/docs/getting-started/overview", summary: "Introduction to Prady, installation, architecture verification, and writing your first program." },
    { title: "Installation & Setup", category: "Guides", url: "/docs/getting-started/installation", summary: "Download native binaries for Windows, macOS, Linux or use one-line curl/powershell installers." },
    { title: "Hello World & Scaffolding", category: "Guides", url: "/docs/getting-started/hello-world", summary: "Creating your first Prady source file, building with LLVM, and running via CLI." },
    { title: "The Basics", category: "Handbook", url: "/docs/handbook/the-basics", summary: "Core syntax, variables, mutable state, type annotations, and expression blocks." },
    { title: "Everyday Types", category: "Handbook", url: "/docs/handbook/everyday-types", summary: "Primitives: Int, Float, Bool, Char, String, Option, Result, and structural typing." },
    { title: "Control Flow & Pattern Matching", category: "Handbook", url: "/docs/handbook/control-flow", summary: "if/else, while, for, foreach..in, and exhaustive switch/case statements." },
    { title: "Functions & Lambdas", category: "Handbook", url: "/docs/handbook/functions-and-lambdas", summary: "Named functions, first-class closures, lambdas, higher-order methods filter/map/reduce." },
    { title: "Architecture-as-Code Contracts", category: "Handbook", url: "/docs/handbook/architecture-contracts", summary: "Enforcing architectural boundaries, layers, cannot import rules, and compiler validations." },
    { title: "Keywords & Grammar Reference", category: "Reference", url: "/docs/reference/keywords-and-syntax", summary: "Complete keyword index, operator precedence, grammar specifications." },
    { title: "Standard Library Overview", category: "Reference", url: "/docs/reference/standard-library", summary: "Core standard library modules: io, math, fs, collections, sys." },
    { title: "28 Built-In Data Structures", category: "Reference", url: "/docs/reference/data-structures", summary: "Complete reference for all 28 data structures: RedBlackTree, Trie, LRUCache, Graph, Heap, etc." },
    { title: "Prady CLI (prady run, build, check)", category: "Tooling", url: "/docs/tooling/cli-reference", summary: "Command-line tool reference for running, building, checking architecture, and testing." },
    { title: "Package Manager (prady add)", category: "Tooling", url: "/docs/tooling/package-manager", summary: "Managing dependencies, prady.toml configuration, semantic version resolution." },
    { title: "VS Code Extension & LSP", category: "Tooling", url: "/docs/tooling/editor-extensions", summary: "Language Server Protocol integration, real-time diagnostics, hover tooltips, and autocomplete." },
    { title: "Interactive Playground", category: "Playground", url: "/play", summary: "In-browser live compiler and evaluator with AST explorer and architecture checker." },
    { title: "Downloads Portal", category: "Releases", url: "/download", summary: "Official binary packages for Windows, macOS, and Linux." }
  ];

  function setupSearch() {
    const backdrop = document.getElementById('search-modal-backdrop');
    const input = document.getElementById('modal-search-input');
    const resultsContainer = document.getElementById('search-results-list');
    const closeBtn = document.getElementById('modal-close-btn');

    if (!backdrop || !input || !resultsContainer) return;

    let selectedIndex = -1;
    let filteredResults = [];

    function openModal() {
      backdrop.classList.remove('hidden');
      input.value = '';
      input.focus();
      renderResults('');
    }

    function closeModal() {
      backdrop.classList.add('hidden');
      selectedIndex = -1;
    }

    // Global keyboard triggers: "/" or "Ctrl+K" or "Cmd+K"
    document.addEventListener('keydown', (e) => {
      if ((e.key === '/' || ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k')) && backdrop.classList.contains('hidden')) {
        const activeTag = document.activeElement ? document.activeElement.tagName : '';
        if (activeTag !== 'INPUT' && activeTag !== 'TEXTAREA') {
          e.preventDefault();
          openModal();
        }
      } else if (e.key === 'Escape' && !backdrop.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Close on backdrop click
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Search input handler
    input.addEventListener('input', (e) => {
      renderResults(e.target.value.toLowerCase().trim());
    });

    // Keyboard navigation in results
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (filteredResults.length > 0) {
          selectedIndex = (selectedIndex + 1) % filteredResults.length;
          updateSelectedHighlight();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (filteredResults.length > 0) {
          selectedIndex = (selectedIndex - 1 + filteredResults.length) % filteredResults.length;
          updateSelectedHighlight();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && selectedIndex < filteredResults.length) {
          window.location.href = filteredResults[selectedIndex].url;
          closeModal();
        }
      }
    });

    function renderResults(query) {
      selectedIndex = -1;
      if (!query) {
        filteredResults = searchIndex.slice(0, 6);
      } else {
        filteredResults = searchIndex.filter(item => 
          item.title.toLowerCase().includes(query) ||
          item.category.toLowerCase().includes(query) ||
          item.summary.toLowerCase().includes(query)
        );
      }

      if (filteredResults.length === 0) {
        resultsContainer.innerHTML = `<div class="search-empty-state">No documentation pages found for "${query}"</div>`;
        return;
      }

      resultsContainer.innerHTML = filteredResults.map((item, idx) => `
        <a href="${item.url}" class="search-result-item ${idx === 0 ? 'selected' : ''}" data-index="${idx}">
          <div class="search-result-header">
            <span class="search-result-title">${item.title}</span>
            <span class="search-result-category">${item.category}</span>
          </div>
          <div class="search-result-snippet">${item.summary}</div>
        </a>
      `).join('');

      if (filteredResults.length > 0) selectedIndex = 0;
    }

    function updateSelectedHighlight() {
      const items = resultsContainer.querySelectorAll('.search-result-item');
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('selected');
        }
      });
    }

    // Attach click listeners to any external search trigger buttons
    document.querySelectorAll('[data-open-search]').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });
  }

  setupSearch();
  document.addEventListener('astro:after-swap', setupSearch);
</script>
