---
// download.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';

const latestData = JSON.parse(
  fs.readFileSync('./public/latest.json', 'utf-8')
);

const downloads = [
  {
    platform: 'Windows (x64)',
    icon: '🪟',
    filename: 'prady-v1.0.0-x86_64-pc-windows-msvc.zip',
    url: latestData.assets['windows-x64'].url,
    checksum: latestData.assets['windows-x64'].checksum,
    arch: 'x86_64'
  },
  {
    platform: 'macOS Apple Silicon',
    icon: '🍎',
    filename: 'prady-v1.0.0-aarch64-apple-darwin.tar.gz',
    url: latestData.assets['macos-arm'].url,
    checksum: latestData.assets['macos-arm'].checksum,
    arch: 'Apple Silicon (M1/M2/M3/M4)'
  },
  {
    platform: 'macOS Intel',
    icon: '🍎',
    filename: 'prady-v1.0.0-x86_64-apple-darwin.tar.gz',
    url: latestData.assets['macos-intel'].url,
    checksum: latestData.assets['macos-intel'].checksum,
    arch: 'x86_64 Intel Mac'
  },
  {
    platform: 'Linux (x64)',
    icon: '🐧',
    filename: 'prady-v1.0.0-x86_64-unknown-linux-gnu.tar.gz',
    url: latestData.assets['linux-x64'].url,
    checksum: latestData.assets['linux-x64'].checksum,
    arch: 'x86_64 GNU/Linux'
  },
  {
    platform: 'Linux (ARM64)',
    icon: '🐧',
    filename: 'prady-v1.0.0-aarch64-unknown-linux-gnu.tar.gz',
    url: latestData.assets['linux-arm'].url,
    checksum: latestData.assets['linux-arm'].checksum,
    arch: 'aarch64 GNU/Linux'
  }
];
---

<BaseLayout 
  title="Download Prady Binaries (v1.0.0 GA) · Official Releases"
  description="Download official standalone binaries for the Prady Programming Language across Windows, macOS, and Linux."
  activeNav="download"
>
  <div class="download-page container">
    <header class="download-header">
      <span class="badge">Production Releases</span>
      <h1 class="page-title">Download Prady v{latestData.version} GA</h1>
      <p class="page-lead">
        Get standalone native binaries for your operating system. No dependencies, runtimes, or VMs required.
      </p>
      <div class="release-meta">
        <span>Released on <strong>{latestData.releaseDate}</strong></span>
        <span>•</span>
        <a href={latestData.releaseNotesUrl} target="_blank" rel="noopener noreferrer" class="release-notes-link">View Release Notes on GitHub ↗</a>
      </div>
    </header>

    <!-- One-line automated installers -->
    <div class="installers-section">
      <h2 class="sub-title">Automated Terminal Installation</h2>
      <div class="installers-grid">
        <div class="installer-card">
          <div class="card-header">
            <span class="os-tag">macOS & Linux</span>
            <span class="shell-tag">Bash / Zsh</span>
          </div>
          <div class="command-box">
            <code>curl -fsSL {latestData.assets['install-sh']} | sh</code>
          </div>
        </div>

        <div class="installer-card">
          <div class="card-header">
            <span class="os-tag">Windows</span>
            <span class="shell-tag">PowerShell</span>
          </div>
          <div class="command-box">
            <code>irm {latestData.assets['install-ps1']} | iex</code>
          </div>
        </div>
      </div>
    </div>

    <!-- Binary Downloads Grid -->
    <div class="binaries-section">
      <h2 class="sub-title">Standalone Binary Archives</h2>
      <div class="binaries-list">
        {downloads.map((item) => (
          <div class="binary-row">
            <div class="binary-info">
              <span class="platform-icon">{item.icon}</span>
              <div>
                <h3 class="platform-name">{item.platform}</h3>
                <span class="arch-name">{item.arch}</span>
              </div>
            </div>

            <div class="binary-actions">
              <a href={item.url} class="btn btn-primary btn-sm download-btn">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Archive</span>
              </a>
              <a href={item.checksum} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm checksum-btn">
                SHA256
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Verification Section -->
    <div class="verification-box">
      <h3 class="verify-title">Verifying Binary Integrity</h3>
      <p class="verify-text">
        Every official release is cryptographically hashed. You can verify your downloaded archive before extracting:
      </p>
      <pre><code># Linux / macOS
sha256sum prady-v1.0.0-*.tar.gz

# Windows PowerShell
Get-FileHash -Algorithm SHA256 .\\prady-v1.0.0-*.zip</code></pre>
    </div>
  </div>
</BaseLayout>

<style>
  .download-page {
    max-width: 900px;
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .download-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .page-title {
    font-size: 2.75rem;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .release-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .release-notes-link {
    font-weight: 600;
  }

  .sub-title {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .installers-section {
    margin-bottom: 3.5rem;
  }

  .installers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .installer-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .os-tag {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .shell-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .command-box {
    background-color: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }

  .command-box code {
    color: #f8fafc;
    font-size: 0.85rem;
    word-break: break-all;
    background: transparent;
    border: none;
    padding: 0;
  }

  .binaries-section {
    margin-bottom: 3.5rem;
  }

  .binaries-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .binary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    transition: all 0.15s ease;
  }

  .binary-row:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .binary-info {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .platform-icon {
    font-size: 2rem;
  }

  .platform-name {
    font-size: 1.1rem;
    margin: 0 0 0.2rem 0;
  }

  .arch-name {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .binary-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .verification-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .verify-title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .verify-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .installers-grid {
      grid-template-columns: 1fr;
    }
    .binary-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .binary-actions {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
