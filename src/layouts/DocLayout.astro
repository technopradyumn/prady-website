---
// DocLayout.astro
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface NavLink {
  title: string;
  slug: string;
}

interface Props {
  title: string;
  description?: string;
  badge?: string;
  breadcrumbs?: { title: string; link?: string }[];
  headings?: Heading[];
  prevPage?: NavLink;
  nextPage?: NavLink;
  githubPath?: string;
  activeNav?: 'handbook' | 'docs' | 'reference' | 'tooling';
}

const { 
  title, 
  description, 
  badge, 
  breadcrumbs = [{ title: 'Docs', link: '/docs' }, { title }],
  headings = [], 
  prevPage, 
  nextPage, 
  githubPath = 'src/content/docs',
  activeNav = 'docs'
} = Astro.props;

const currentPath = Astro.url.pathname;
const editUrl = `https://github.com/technopradyumn/prady/edit/main/${githubPath}`;
---

<BaseLayout title={`${title} · Prady Docs`} description={description} activeNav={activeNav}>
  <div class="doc-page-container">
    <Sidebar currentPath={currentPath} />

    <main class="doc-main-content">
      <div class="doc-content-wrapper">
        <!-- Breadcrumbs -->
        <nav class="doc-breadcrumbs" aria-label="Breadcrumbs">
          {breadcrumbs.map((crumb, idx) => (
            <>
              {idx > 0 && <span class="breadcrumb-separator">/</span>}
              {crumb.link ? (
                <a href={crumb.link} class="breadcrumb-link">{crumb.title}</a>
              ) : (
                <span class="breadcrumb-current">{crumb.title}</span>
              )}
            </>
          ))}
        </nav>

        <!-- Article Title & Meta -->
        <header class="doc-header">
          <div class="title-row">
            <h1 class="doc-title">{title}</h1>
            {badge && <span class="badge">{badge}</span>}
          </div>
          {description && <p class="doc-lead">{description}</p>}
        </header>

        <!-- Main Body -->
        <article class="doc-prose">
          <slot />
        </article>

        <!-- Bottom Page Controls -->
        <footer class="doc-footer">
          <div class="edit-link-row">
            <a href={editUrl} target="_blank" rel="noopener noreferrer" class="edit-link">
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span>Edit this page on GitHub</span>
            </a>
          </div>

          <div class="page-pagination">
            {prevPage ? (
              <a href={prevPage.slug} class="pagination-link prev">
                <span class="pagination-label">← Previous</span>
                <span class="pagination-title">{prevPage.title}</span>
              </a>
            ) : <div />}

            {nextPage && (
              <a href={nextPage.slug} class="pagination-link next">
                <span class="pagination-label">Next →</span>
                <span class="pagination-title">{nextPage.title}</span>
              </a>
            )}
          </div>
        </footer>
      </div>
    </main>

    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<style>
  .doc-page-container {
    display: flex;
    min-height: calc(100vh - var(--header-height));
    max-width: var(--container-max-width);
    margin: 0 auto;
    width: 100%;
  }

  .doc-main-content {
    flex: 1;
    min-width: 0;
    padding: 2.5rem 3rem 4rem 3rem;
  }

  .doc-content-wrapper {
    max-width: 820px;
    margin: 0 auto;
  }

  .doc-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb-link {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb-link:hover {
    color: var(--accent);
  }

  .breadcrumb-current {
    color: var(--text-primary);
    font-weight: 500;
  }

  .breadcrumb-separator {
    color: var(--border-color);
  }

  .doc-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .doc-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }

  .doc-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-top: 0.75rem;
    margin-bottom: 0;
  }

  /* Markdown / Prose Styling */
  .doc-prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .doc-prose :global(h2) {
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .doc-prose :global(h3) {
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .doc-prose :global(p) {
    margin-bottom: 1.4rem;
  }

  .doc-prose :global(ul),
  .doc-prose :global(ol) {
    margin-bottom: 1.4rem;
    padding-left: 1.5rem;
  }

  .doc-prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .doc-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95rem;
  }

  .doc-prose :global(th),
  .doc-prose :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-color);
    text-align: left;
  }

  .doc-prose :global(th) {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-weight: 600;
  }

  .doc-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }

  .edit-link-row {
    margin-bottom: 2rem;
  }

  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .edit-link:hover {
    color: var(--accent);
  }

  .page-pagination {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    text-decoration: none;
    min-width: 180px;
    transition: all 0.15s ease;
  }

  .pagination-link:hover {
    border-color: var(--accent);
    background-color: var(--bg-tertiary);
    transform: translateY(-2px);
  }

  .pagination-link.next {
    align-items: flex-end;
    margin-left: auto;
  }

  .pagination-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .pagination-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .doc-main-content {
      padding: 1.5rem 1rem 3rem 1rem;
    }
  }
</style>
