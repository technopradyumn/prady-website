---
// docs/[...slug].astro
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

let activeNav: 'handbook' | 'docs' | 'reference' | 'tooling' = 'docs';
if (entry.id.startsWith('handbook/')) activeNav = 'handbook';
else if (entry.id.startsWith('reference/')) activeNav = 'reference';
else if (entry.id.startsWith('tooling/')) activeNav = 'tooling';
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  badge={entry.data.badge}
  headings={headings}
  prevPage={entry.data.prev}
  nextPage={entry.data.next}
  githubPath={`src/content/docs/${entry.id}.md`}
  activeNav={activeNav}
  breadcrumbs={[
    { title: 'Docs', link: '/docs' },
    { title: entry.data.category || 'Guide' },
    { title: entry.data.title }
  ]}
>
  <Content />
</DocLayout>
