---
// download.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';

const latestData = JSON.parse(
  fs.readFileSync('./public/latest.json', 'utf-8')
);
const assetFilename = (url: string) => new URL(url).pathname.split('/').pop() || '';

const downloads = [
  {
    platform: 'Windows (x64)',
    icon: '🪟',
    filename: assetFilename(latestData.assets['windows-x64'].url),
    url: latestData.assets['windows-x64'].url,
    checksum: latestData.assets['windows-x64'].checksum,
    arch: 'x86_64'
  },
  {
    platform: 'macOS Apple Silicon',
    icon: '🍎',
    filename: assetFilename(latestData.assets['macos-arm'].url),
    url: latestData.assets['macos-arm'].url,
    checksum: latestData.assets['macos-arm'].checksum,
    arch: 'Apple Silicon (M1/M2/M3/M4)'
  },
  {
    platform: 'macOS Intel',
    icon: '🍎',
    filename: assetFilename(latestData.assets['macos-intel'].url),
    url: latestData.assets['macos-intel'].url,
    checksum: latestData.assets['macos-intel'].checksum,
    arch: 'x86_64 Intel Mac'
  },
  {
    platform: 'Linux (x64)',
    icon: '🐧',
    filename: assetFilename(latestData.assets['linux-x64'].url),
    url: latestData.assets['linux-x64'].url,
    checksum: latestData.assets['linux-x64'].checksum,
    arch: 'x86_64 GNU/Linux'
  },
  {
    platform: 'Linux (ARM64)',
    icon: '🐧',
    filename: assetFilename(latestData.assets['linux-arm'].url),
    url: latestData.assets['linux-arm'].url,
    checksum: latestData.assets['linux-arm'].checksum,
    arch: 'aarch64 GNU/Linux'
  }
];
---

<BaseLayout 
  title={`Download Prady ${latestData.version} · Official Releases`}
  description="Download official standalone binaries for the Prady Programming Language across Windows, macOS, and Linux."
  activeNav="download"
>
  <div class="download-page container">
    <header class="download-header">
      <span class="badge">Production Releases</span>
      <h1 class="page-title">Download Prady v{latestData.version} GA</h1>
      <p class="page-lead">
        Get standalone native binaries for your operating system. No dependencies, runtimes, or VMs required.
      </p>
      <div class="release-meta">
        <span>Released on <strong>{latestData.releaseDate}</strong></span>
        <span>•</span>
        <a href={latestData.releaseNotesUrl} target="_blank" rel="noopener noreferrer" class="release-notes-link">View Release Notes on GitHub ↗</a>
      </div>
    </header>

    <!-- One-line automated installers -->
    <div class="installers-section">
      <h2 class="sub-title">Automated Terminal Installation</h2>
      <div class="installers-grid">
        <div class="installer-card">
          <div class="card-header">
            <span class="os-tag">macOS & Linux</span>
            <span class="shell-tag">Bash / Zsh</span>
          </div>
          <div class="command-box">
            <code>curl -fsSL {latestData.assets['install-sh']} | sh</code>
          </div>
        </div>

        <div class="installer-card">
          <div class="card-header">
            <span class="os-tag">Windows</span>
            <span class="shell-tag">PowerShell</span>
          </div>
          <div class="command-box">
            <code>irm {latestData.assets['install-ps1']} | iex</code>
          </div>
          <p class="installer-note">
            In Command Prompt, run: <code>powershell -NoProfile -ExecutionPolicy Bypass -Command "irm {latestData.assets['install-ps1']} | iex"</code>
          </p>
        </div>
      </div>
      <p class="installer-note">After installation, open a new terminal and verify with <code>prady version</code>. The installers add the CLI and language server to your user PATH; no Rust toolchain or administrator access is required.</p>
    </div>

    <!-- Binary Downloads Grid -->
    <div class="binaries-section">
      <h2 class="sub-title">Standalone Binary Archives</h2>
      <div class="binaries-list">
        {downloads.map((item) => (
          <div class="binary-row">
            <div class="binary-info">
              <span class="platform-icon">{item.icon}</span>
              <div>
                <h3 class="platform-name">{item.platform}</h3>
                <span class="arch-name">{item.arch}</span>
              </div>
            </div>

            <div class="binary-actions">
              <a href={item.url} class="btn btn-primary btn-sm download-btn">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span>Download Archive</span>
              </a>
              <a href={item.checksum} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm checksum-btn">
                SHA256
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Windows SmartScreen Notice -->
    <div class="smartscreen-notice">
      <div class="notice-header">
        <span class="notice-icon">🛡️</span>
        <div>
          <h3 class="notice-title">Windows SmartScreen Warning?</h3>
          <p class="notice-subtitle">This is expected for new apps — here's how to proceed safely.</p>
        </div>
      </div>
      <p class="notice-body">
        When you run the downloaded <code>.exe</code> installer, Windows Defender SmartScreen may show:
        <em>"Windows protected your PC — Microsoft Defender SmartScreen prevented an unrecognized app from starting."</em>
        This happens because the binary is not yet code-signed. It is <strong>not a virus</strong>.
      </p>
      <div class="notice-steps">
        <div class="notice-step">
          <span class="step-num">1</span>
          <span>Click <strong>"More info"</strong> (small link below the warning text)</span>
        </div>
        <div class="notice-step">
          <span class="step-num">2</span>
          <span>A <strong>"Run anyway"</strong> button will appear — click it to continue</span>
        </div>
        <div class="notice-step">
          <span class="step-num">3</span>
          <span>Installation proceeds normally ✅</span>
        </div>
      </div>
      <p class="notice-alt">
        <strong>Alternative:</strong> Right-click the <code>.exe</code> → <strong>Properties</strong> → check <strong>"Unblock"</strong> at the bottom → click <strong>Apply</strong>.
      </p>
    </div>

    <!-- Verification Section -->
    <div class="verification-box">
      <h3 class="verify-title">Verifying Binary Integrity</h3>
      <p class="verify-text">
        Every official release archive has a SHA-256 checksum. Compare the downloaded file with its matching checksum before extracting:
      </p>
      <pre><code># Linux / macOS
sha256sum -c prady-*.tar.gz.sha256

# Windows PowerShell
Get-FileHash -Algorithm SHA256 .\\prady-*.zip</code></pre>
    </div>

    <div class="verification-box">
      <h3 class="verify-title">VS Code Extension</h3>
      <p class="verify-text">Install from the VS Code Marketplace when available, or download the packaged extension from the extension project's GitHub releases.</p>
      <a class="btn btn-secondary" href="https://marketplace.visualstudio.com/items?itemName=technopradyumn.prady-lang" target="_blank" rel="noopener noreferrer">VS Code Marketplace</a>
      <a class="btn btn-outline" href="https://github.com/technopradyumn/vscode-prady/releases/latest" target="_blank" rel="noopener noreferrer">Extension releases</a>
    </div>
  </div>
</BaseLayout>

<style>
  .download-page {
    max-width: 900px;
    padding-top: 4rem;
    padding-bottom: 5rem;
  }

  .download-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .page-title {
    font-size: 2.75rem;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .release-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .release-notes-link {
    font-weight: 600;
  }

  .sub-title {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .installers-section {
    margin-bottom: 3.5rem;
  }

  .installer-note {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  .installers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .installer-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.25rem;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .os-tag {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .shell-tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .command-box {
    background-color: var(--code-bg);
    border: 1px solid var(--code-border);
    border-radius: 6px;
    padding: 0.75rem 1rem;
  }

  .command-box code {
    color: #f8fafc;
    font-size: 0.85rem;
    word-break: break-all;
    background: transparent;
    border: none;
    padding: 0;
  }

  .binaries-section {
    margin-bottom: 3.5rem;
  }

  .binaries-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .binary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    transition: all 0.15s ease;
  }

  .binary-row:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .binary-info {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .platform-icon {
    font-size: 2rem;
  }

  .platform-name {
    font-size: 1.1rem;
    margin: 0 0 0.2rem 0;
  }

  .arch-name {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .binary-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Windows SmartScreen Notice */
  .smartscreen-notice {
    margin-bottom: 2rem;
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.07) 0%, rgba(234, 179, 8, 0.03) 100%);
    border: 1px solid rgba(234, 179, 8, 0.35);
    border-left: 4px solid #eab308;
    border-radius: 10px;
    padding: 1.5rem 1.75rem;
  }

  .notice-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .notice-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .notice-title {
    font-size: 1.1rem;
    margin: 0 0 0.2rem 0;
    color: #ca8a04;
  }

  .notice-subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  .notice-body {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1.1rem;
    line-height: 1.65;
  }

  .notice-steps {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1.1rem;
  }

  .notice-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    background-color: #eab308;
    color: #000;
    font-weight: 700;
    font-size: 0.75rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .notice-alt {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(234, 179, 8, 0.2);
  }

  .verification-box {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .verify-title {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .verify-text {
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .installers-grid {
      grid-template-columns: 1fr;
    }
    .binary-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .binary-actions {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>
